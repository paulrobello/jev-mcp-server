{
  "name": "jev-mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing the Jev decision tools (ask_jev, ask_jev_files, pick_first_file, ask_jev_file_*) — typed noul/choice/score questions over files and state without reading them into context",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "fmt": "bunx biome format --write .",
    "fmt-check": "bunx biome format ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "bun-types": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
